APP_NAME="Infrastructure Registry API"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://app-api.test

API_KEY=local-dev-key

# Local development talks to the MySQL container of the stack through the
# published port: docker compose up -d mysql
DB_HOST=127.0.0.1
DB_PORT=33063
DB_DATABASE=app_api
DB_USERNAME=api
DB_PASSWORD=secret

LOG_PATH=storage/logs/api.log
LOG_LEVEL=info
