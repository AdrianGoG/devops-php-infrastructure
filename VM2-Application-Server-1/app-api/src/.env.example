APP_NAME="Infrastructure Registry API"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://192.168.0.170:8083

# Required for every write request, sent as the X-API-Key header.
# Jenkins uses it when it records a deployment at the end of the pipeline.
API_KEY=change-me-before-deploying

# MySQL service of the Docker stack.
# Inside the containers the host is the service name; from the host machine it
# is 127.0.0.1 on the published port (33063).
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=app_api
DB_USERNAME=api
DB_PASSWORD=secret

# Logs are written as one JSON object per line so Logstash can ingest them
# without a custom grok pattern.
LOG_PATH=storage/logs/api.log
LOG_LEVEL=info
