{
    "name": "devops-php-infrastructure/app-api",
    "description": "Infrastructure registry API - the legacy PHP 7.4 service of the estate",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^7.2",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "app/legacy/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/console migrate",
        "seed": "php bin/console seed",
        "fresh": "php bin/console fresh"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
