# Environment of the Docker stack (docker compose --env-file .env).
# The application itself reads src/.env - see src/.env.example.

COMPOSE_PROJECT_NAME=app-user-dashboard

# Port exposed by the nginx container on the host / on VM2.
DASHBOARD_HTTP_PORT=8082

# MySQL service of the stack.
MYSQL_DATABASE=user_dashboard
MYSQL_USER=dashboard
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=33062
