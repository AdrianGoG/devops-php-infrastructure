APP_NAME="User Dashboard"
APP_ENV=local
APP_KEY=base64:ez2WNzxagXeCaDHCBfz+dI6n3koqD84f26M5wOoykfM=
APP_DEBUG=true
APP_URL=http://app-user-dashboard.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development talks to the MySQL container through the published port:
# docker compose up -d mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33062
DB_DATABASE=user_dashboard
DB_USERNAME=dashboard
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="dashboard@devops.local"
MAIL_FROM_NAME="${APP_NAME}"

# Locally app-api is served by Herd on PHP 7.4.
REGISTRY_BASE_URL=http://app-api.test
REGISTRY_TIMEOUT=4
REGISTRY_CACHE_SECONDS=15
