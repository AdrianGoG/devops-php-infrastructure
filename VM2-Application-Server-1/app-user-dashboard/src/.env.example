APP_NAME="User Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.0.169:8082

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL service of the Docker stack.
# Inside the containers the host is the service name; from the host machine it
# is 127.0.0.1 on the published port (33062).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=user_dashboard
DB_USERNAME=dashboard
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="dashboard@devops.local"
MAIL_FROM_NAME="${APP_NAME}"

# app-api - the infrastructure registry this dashboard reads from.
# On VM2 the two applications talk over the server's own address.
REGISTRY_BASE_URL=http://192.168.0.169:8083
REGISTRY_TIMEOUT=4
REGISTRY_CACHE_SECONDS=15
