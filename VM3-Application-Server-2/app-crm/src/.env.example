APP_NAME="CRM"
APP_ENV=production
APP_DEBUG=false

# MySQL service of the Docker stack.
# Inside the containers the host is the service name; from the host machine it
# is 127.0.0.1 on the published port (33064).
DB_HOST=mysql
DB_PORT=3306
DB_NAME=crm
DB_USER=crm
DB_PASS=secret

# The account bin/install.php creates on the first deployment. Changing these
# afterwards does not change an account that already exists - the script never
# touches one it finds.
CRM_ADMIN_NAME="DevOps Admin"
CRM_ADMIN_EMAIL=admin@devops.test
CRM_ADMIN_PASSWORD=password
