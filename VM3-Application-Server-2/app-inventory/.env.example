# Environment of the Docker stack (docker compose --env-file .env).
# The application itself reads src/.env - see src/.env.example.

COMPOSE_PROJECT_NAME=app-inventory

# Port exposed by the nginx container on the host / on VM3.
INVENTORY_HTTP_PORT=8082

# MySQL service of the stack.
MYSQL_DATABASE=inventory
MYSQL_USER=inventory
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=33065
