APP_NAME=Inventory
APP_ENV=local
APP_KEY=base64:XioG3H2bzZ2qDkLn5ME6JJRR2c8Qczsz0+s7m8fhAZk=
APP_DEBUG=true
APP_URL=http://app-inventory.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development talks to the MySQL container through the published port:
# docker compose up -d mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33065
DB_DATABASE=inventory
DB_USERNAME=inventory
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="inventory@devops.local"
MAIL_FROM_NAME="${APP_NAME}"
