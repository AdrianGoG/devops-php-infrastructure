APP_NAME=Inventory
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.0.171:8082

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# MySQL service of the Docker stack.
# Inside the containers the host is the service name; from the host machine it
# is 127.0.0.1 on the published port (33065).
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=inventory
DB_USERNAME=inventory
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="inventory@devops.local"
MAIL_FROM_NAME="${APP_NAME}"
