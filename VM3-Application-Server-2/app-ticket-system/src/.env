APP_NAME=Helpdesk
APP_ENV=local
APP_KEY=base64:xCJh1ixGOmZzLndxDf+yHiKYf8mYLcrHqo7q/tUJdlk=
APP_DEBUG=true
APP_URL=http://app-ticket-system.test

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development talks to the MySQL container through the published port:
# docker compose up -d mysql
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=33066
DB_DATABASE=tickets
DB_USERNAME=tickets
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="helpdesk@devops.local"
MAIL_FROM_NAME="${APP_NAME}"
