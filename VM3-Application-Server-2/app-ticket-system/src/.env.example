APP_NAME=Helpdesk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.0.171:8083

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Local development talks to the MySQL container through the published port:
# docker compose up -d mysql
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=tickets
DB_USERNAME=tickets
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=log
MAIL_FROM_ADDRESS="helpdesk@devops.local"
MAIL_FROM_NAME="${APP_NAME}"
