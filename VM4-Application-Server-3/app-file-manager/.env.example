# Environment of the Docker stack (docker compose --env-file .env).
# The application itself reads src/.env - see src/.env.example.

COMPOSE_PROJECT_NAME=app-file-manager

# Port exposed by the nginx container on the host / on VM4.
HTTP_PORT=8082

# MySQL service of the stack.
MYSQL_DATABASE=filemanager
MYSQL_USER=filemanager
MYSQL_PASSWORD=secret
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=33068
