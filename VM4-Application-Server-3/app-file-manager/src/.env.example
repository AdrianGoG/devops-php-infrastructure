APP_NAME="File Manager"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.0.172:8082

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Local development talks to the MySQL container through the published port:
# docker compose up -d mysql
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=filemanager
DB_USERNAME=filemanager
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log
