APP_NAME="Estate Monitor"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://192.168.0.125:8083

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=monitor
DB_USERNAME=monitor
DB_PASSWORD=secret

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# The servers of the estate. Each probe URL is built from these; override a
# single one with ESTATE_URL_<APP> if an application moves.
ESTATE_BASE_VM2=http://192.168.0.169
ESTATE_BASE_VM3=http://192.168.0.159
ESTATE_BASE_VM4=http://192.168.0.125
ESTATE_TIMEOUT=3
ESTATE_CACHE_SECONDS=10
